#version 330

// Input vertex attributes (from vertex shader)
in vec2 fragTexCoord;
in vec3 fragNormal;
in vec4 fragColor;

// Input uniform values
uniform sampler2D texture0;
uniform vec4 colDiffuse;
uniform vec3 cameraLookat;
uniform vec3 sunLookat;
uniform vec3 sunColor;

// Output fragment color
out vec4 finalColor;

const float pi = 3.14159265359;

float getDiffusion(vec3 normal)
{
	float length0 = length(sunLookat);
	float length1 = length(normal);
	float dotproduct = dot(-sunLookat, normal);
	float angle = acos(dotproduct / (length0 * length1));
	float lowestlevel = 1 / 4f;
	return (angle / pi) * lowestlevel + lowestlevel;
}

void main()
{
	vec4 source = texture(texture0, fragTexCoord) * fragColor;
	float diffusion = getDiffusion(fragNormal);
	vec3 color = source.xyz * diffusion;
	vec4 final = vec4(color, source.w);
	finalColor = final;
}