				<Item class="Script" referent="RBX214">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local sign = script.Parent 
local teleporter = sign.Parent 

local placeId = teleporter.TouchScript.TeleportScript.PlaceId
local decal
local tex

if placeId then 
	placeId = placeId.Value
	decal = script.Parent.Decal
	tex = "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=420&height=230&assetId=" ..placeId
	decal.Texture = tex
end



]]></ProtectedString>
