<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jitter2" Version="2.10.0" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <PackageReference Include="ZstdNet" Version="1.5.7" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="content\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../moonsharp/src/MoonSharp.Interpreter/MoonSharp.Interpreter.csproj" />
    <ProjectReference Include="../NetBlox.API/NetBlox.API.csproj" />
  </ItemGroup>

</Project>
