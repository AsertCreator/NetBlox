			<Properties>
				<ProtectedString name="Source"><![CDATA[print("Lua!")
printidentity()
warn("oOoOooOOoOoOoOhHhhh")

print("Players in here: " .. tostring(#game.Players:GetChildren()))

i = 0

local function messageChange()
	workspace.Message.Text = "netblox engine testing place, iteration #" .. tostring(i);
	
	i += 1;
	
	task.delay(3, messageChange);
end

task.delay(3, messageChange);]]></ProtectedString>
